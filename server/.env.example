# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/hiremind?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-long-random-jwt-secret-here
SESSION_SECRET=your-long-random-session-secret-here

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET_NAME=hiremind-resumes

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# ── AI Service (Python / Hugging Face Space) ──────────────────────────────────
# This is the URL of your deployed ai-service (Hugging Face Space, Railway, etc.)
# The Node server uses this to call /analyze, /parse_resume, /prep_chat, etc.
AI_SERVICE_URL=https://your-username-hiremind-ai.hf.space

# ── URLs ──────────────────────────────────────────────────────────────────────
CLIENT_URL=https://your-app.vercel.app
SERVER_URL=https://your-backend.onrender.com

# ── Node environment ──────────────────────────────────────────────────────────
NODE_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
# CLIENT ENVIRONMENT VARIABLES  (create client/.env in your client folder)
# ─────────────────────────────────────────────────────────────────────────────
# VITE_API_URL=https://your-backend.onrender.com
#
# NOTE: VITE_AI_URL is NO LONGER NEEDED in the client.
# The InterviewPrepChatbot now routes through /api/ai/prep_chat on the Node
# server, so the AI service URL is kept server-side only. Just set VITE_API_URL.
